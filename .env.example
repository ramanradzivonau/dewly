# Copy to .env.local. Only VITE_* values reach the browser — they are public by design.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=

# Server-only secrets: set with `supabase secrets set`, never commit or prefix with VITE_
# GEMINI_API_KEY=
# PLANTNET_API_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:your-project-email@example.com
